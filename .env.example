# WEBHOOK_URL: n8n webhook that receives each scan and handles emailing it out.
# Leave unset until the n8n workflow exists — sending will fail with a clear
# error until this is filled in, no placeholder URL is used here.
WEBHOOK_URL=

# WEBHOOK_SECRET: sent as the X-Webhook-Secret header on every request to
# WEBHOOK_URL. Must match the Header Auth credential value on the n8n
# Webhook trigger node exactly.
WEBHOOK_SECRET=
